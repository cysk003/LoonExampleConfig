# Loon Rewrite 新语法示例
# 原文件：AutoRewrite_Example.list
# 格式：request|response if <条件> then <动作> [| <动作> ...]
# 使用：按需将规则复制到配置或插件的 [Rewrite] 段；本文件本身不含段名。
# 本文件是互相独立的语法示例集合，部分条件重复，不应整份同时启用。
# HTTPS 请求需要在 [MITM] 配置对应 hostname，并安装、信任证书。
# ${url} 为完整 URL；~= 为正则匹配；/pattern/i 表示忽略大小写。
# &&、|| 和括号用于组合条件；同一行的多个动作使用 | 分隔。
# 条件捕获使用 as name 声明，通过 ${name.1} 引用；动作自身的正则替换使用 $1。
# 字符串使用双引号；反引号包围的 Raw String 适合 JSON、jq 等包含双引号的内容。

# 一、原文件逐条转换
# 以下保留原条件及目标值；旧语法默认忽略大小写，所以显式添加 /i。

# 01：原 (.*video_id=\w{32})(.*watermark=)(.*) 302 $1；重定向到第一个捕获组。
request if ${url} ~= /(.*video_id=\w{32})(.*watermark=)(.*)/i as video then redirect(302, "${video.1}")
# 02：原 (?<=(carrier|sys)_region=)CN 307 JP；保留原目标 JP，它是相对地址，不是“替换 URL 中的 CN”；完整 URL 示例见下文。
request if ${url} ~= /(?<=(carrier|sys)_region=)CN/i then redirect(307, "JP")
# 03：原 (?<=version_code=)\d{1,}.\d{1}\.\d{1} 307 8.0.0；保留原正则与相对目标，原正则第一个点未转义。
request if ${url} ~= /(?<=version_code=)\d{1,}.\d{1}\.\d{1}/i then redirect(307, "8.0.0")
# 04：原 header 表示替换整个 URL，不是修改 Header 字段，也不会向客户端返回重定向。
request if ${url} ~= /^http:\/\/www\.google\.cn/i then url.replace("http://www.google.com")
# 05：原 ^http://example.com 302 ^https://example.com；保留目标中的 ^ 以便对照，但实际使用应去掉它，见下文。
request if ${url} ~= /^http:\/\/example.com/i then redirect(302, "^https://example.com")
# 06：原 ^http://example.com 307 ^https://example.com；307 保留请求方法，目标中的 ^ 同样需要在实际使用时去掉。
request if ${url} ~= /^http:\/\/example.com/i then redirect(307, "^https://example.com")
# 07：原 reject，直接返回 404。
request if ${url} ~= /^http:\/\/example.com/i then reject(404)
# 08：原 reject-200，直接返回 200。
request if ${url} ~= /^http:\/\/example.com/i then reject(200)
# 09：原 reject-img，返回图片占位响应。
request if ${url} ~= /^http:\/\/example.com/i then reject_img(200)
# 10：原 reject-dict，返回空 JSON 对象 {}。
request if ${url} ~= /^http:\/\/example.com/i then reject_dict(200)
# 11：原 reject-array，返回空 JSON 数组 []。
request if ${url} ~= /^http:\/\/example.com/i then reject_array(200)
# 12：原 header-add，添加请求 Header。
request if ${url} ~= /^http:\/\/example.com/i then request.header.add("Connection", "keep-alive")
# 13：原 header-del，删除请求 Header。
request if ${url} ~= /^http:\/\/example.com/i then request.header.del("Cookie")
# 14：原 header-replace，设置整个字段值；不要与新语法的 header.replace 正则替换混淆。
request if ${url} ~= /^http:\/\/example.com/i then request.header.set("User-Agent", "Unknown")

# 二、完整 URL 修改与重定向

# 将查询参数 carrier_region 或 sys_region 的 CN 改为 JP，并保留 URL 其余部分；只替换当前捕获的一处。
request if ${url} ~= /^(https?:\/\/[^?#]+\?[^#]*?(?:carrier|sys)_region=)CN((?:&[^#]*)?(?:#.*)?)$/i as region then redirect(307, "${region.1}JP${region.2}")
# 修改 version_code 参数为 8.0.0；使用转义后的点号匹配三段版本号，保留其余参数。
request if ${url} ~= /^(https?:\/\/[^?#]+\?[^#]*?version_code=)\d+\.\d+\.\d+((?:&[^#]*)?(?:#.*)?)$/i as version then redirect(307, "${version.1}8.0.0${version.2}")
# HTTP 升级到 HTTPS；匹配域名边界并保留路径、查询参数，目标 URL 不包含正则的 ^。
request if ${url} ~= /^http:\/\/example\.com([\/?#].*)?$/i as secure then redirect(302, "https://example.com${secure.1}")
# 修改上游 URL 而不返回重定向；保留 /v1/ 后的路径及参数。
request if ${url} ~= /^https:\/\/api\.example\.com\/v1\/(.*)$/i as api then url.replace("https://api.example.com/v2/${api.1}")
# 返回带自定义正文的拒绝响应；reject 只用于 request 阶段。
request if ${url} ~= /^https:\/\/example\.com\/blocked(?:[?#]|$)/i then reject(403, "Blocked by local rule")
# 返回视频占位响应。
request if ${url} ~= /^https:\/\/example\.com\/video-ad(?:[?#]|$)/i then reject_video(200)

# 三、条件组合与 Header

# URL 必须匹配，同时请求方法是 GET 或 POST；&& 优先于 ||，使用括号明确分组。
request if ${url} ~= /^https:\/\/api\.example\.com\//i && (${request.method} == "GET" || ${request.method} == "POST") then request.header.set("X-Loon", "true")
# Header 缺失时与 null 比较，再补上字段。
request if ${url} ~= /^https:\/\/api\.example\.com\//i && ${request.header['X-Region']} == null then request.header.set("X-Region", "CN")
# 批量设置 Header；名称数组和值数组长度必须相同，动作按 | 顺序执行。
request if ${url} ~= /^https:\/\/example\.com\/headers\//i then request.header.set(["X-Client", "X-Version"], ["Loon", "2"]) | request.header.del(["Cookie", "X-Legacy"])
# 正则替换已有 Header 中的一部分；$1 引用该动作的正则捕获组。
request if ${url} ~= /^https:\/\/example\.com\/user-agent\//i then request.header.replace("User-Agent", /ExampleApp\/(\d+)\.\d+/, "ExampleApp/$1.0")
# 仅在原始响应状态为 200 且 Content-Type 为 JSON 时修改响应 Header。
response if ${url} ~= /^https:\/\/api\.example\.com\//i && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json(?:;|$)/i then response.header.set("Cache-Control", "no-store") | response.header.del("X-Debug")
# 添加响应 Header；需覆盖已有值时改用 response.header.set。
response if ${url} ~= /^https:\/\/example\.com\/response-header\//i then response.header.add("X-Example", "true")
# 正则替换响应 Header 中的一部分。
response if ${url} ~= /^https:\/\/example\.com\/cache\//i then response.header.replace("Cache-Control", /max-age=\d+/i, "max-age=60")

# 四、Body 与 JSON
# request 动作只能修改请求，response 动作只能修改响应；Body 动作由引擎按需读取正文，无需 Script 的 requires_body 参数。

# 对 POST 请求正文执行正则替换。
request if ${url} ~= /^https:\/\/example\.com\/form(?:[?#]|$)/i && ${request.method} == "POST" then request.body.replace(/(^|&)mode=old(&|$)/, "$1mode=new$2")
# 批量替换响应正文；正则数组与替换数组必须等长。
response if ${url} ~= /^https:\/\/example\.com\/text(?:[?#]|$)/i then response.body.replace([/old-title/, /old-message/], ["new-title", "new-message"])
# 为请求 JSON 增加字段；true 是布尔值，不是字符串 "true"。
request if ${url} ~= /^https:\/\/api\.example\.com\/create(?:[?#]|$)/i && ${request.method} == "POST" then request.json.add("client.preview", true)
# 删除请求 JSON 字段并替换已有字段值。
request if ${url} ~= /^https:\/\/api\.example\.com\/update(?:[?#]|$)/i then request.json.delete("debug") | request.json.replace("client.version", "2.0")
# 批量增加响应 JSON 字段；示范数字和布尔值。
response if ${url} ~= /^https:\/\/api\.example\.com\/metadata(?:[?#]|$)/i then response.json.add(["data.count", "data.preview"], [3, true])
# JSON 路径支持对象字段和数组索引；replace 修改已有字段，delete 删除字段。
response if ${url} ~= /^https:\/\/api\.example\.com\/items(?:[?#]|$)/i then response.json.replace("data.items[0].title", "Example") | response.json.delete(["data.ads", "data.tracking"])
# jq 处理响应 JSON；Raw String 中的 | 属于 jq 过滤器，不是 Rewrite 动作分隔符。
response if ${url} ~= /^https:\/\/api\.example\.com\/feed(?:[?#]|$)/i then response.json.jq(`.data.items |= map(select(.type != "ad"))`)
# jq 处理请求 JSON。
request if ${url} ~= /^https:\/\/api\.example\.com\/submit(?:[?#]|$)/i then request.json.jq(`del(.debug) | .client = "Loon"`)
# 从文件加载响应 jq 过滤器；请先准备对应本地资源或替换为真实资源 URL。
response if ${url} ~= /^https:\/\/api\.example\.com\/jq-file(?:[?#]|$)/i then response.json.jq_file("response-filter.jq")
# 从文件加载请求 jq 过滤器。
request if ${url} ~= /^https:\/\/api\.example\.com\/jq-file(?:[?#]|$)/i then request.json.jq_file("request-filter.jq")

# 五、Mock 正文

# 替换请求正文为 JSON；第三个可选参数表示输入是否为 Base64，默认 false。
request if ${url} ~= /^https:\/\/api\.example\.com\/mock-request(?:[?#]|$)/i && ${request.method} == "POST" then request.body.mock("json", `{"mode":"preview","count":2}`, false)
# 从本地文件替换请求正文；文件必须事先存在。
request if ${url} ~= /^https:\/\/api\.example\.com\/mock-request-file(?:[?#]|$)/i then request.body.mock_file("json", "request.json")
# 构造 JSON Mock 响应；第三个参数为状态码，第四个可选参数表示数据是否为 Base64。
response if ${url} ~= /^https:\/\/mock\.example\.com\/json(?:[?#]|$)/i then response.body.mock("json", `{"code":0,"message":"ok","data":[]}`, 200, false) | response.header.set("Cache-Control", "no-store")
# 使用 Base64 数据作为响应正文；SGVsbG8= 解码为 Hello。
response if ${url} ~= /^https:\/\/mock\.example\.com\/base64(?:[?#]|$)/i then response.body.mock("text", "SGVsbG8=", 200, true)
# 从本地 HTML 文件构造响应；请先准备 example.html。
response if ${url} ~= /^https:\/\/mock\.example\.com\/page(?:[?#]|$)/i then response.body.mock_file("html", "example.html", 200)

# 六、插件参数（仅用于插件，不要直接放入普通配置）
# 先在插件 [Argument] 中声明对应参数，例如 enabled = switch,true，以及 region = input,"CN",type=string。
# 下方规则保持注释状态；复制到声明了参数的插件 [Rewrite] 段后再取消注释。
# 插件开关参与条件判断，字符串参数用于 Header 模板。
# request if ${url} ~= /^https:\/\/api\.example\.com\//i && ${enabled} == true then request.header.set("X-Region", "${region}")
